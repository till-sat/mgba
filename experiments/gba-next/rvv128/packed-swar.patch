+        vuint32m4_t c0=packed_pair_color(selected,0,palette,vl);
+        vuint32m4_t c1=packed_pair_color(selected,8,palette,vl);
+        vuint32m4_t p0=__riscv_vor_vv_u32m4(c0,__riscv_vsll_vx_u32m4(c1,16,vl),vl);
+        p0=__riscv_vand_vx_u32m4(p0,0x7fff7fff,vl);
+        __riscv_vsse32_v_u32m4((uint32_t*)output,8,p0,vl);
+        c0=packed_pair_color(selected,16,palette,vl);
+        c1=packed_pair_color(selected,24,palette,vl);
+        p0=__riscv_vor_vv_u32m4(c0,__riscv_vsll_vx_u32m4(c1,16,vl),vl);
+        p0=__riscv_vand_vx_u32m4(p0,0x7fff7fff,vl);
+        __riscv_vsse32_v_u32m4((uint32_t*)output+1,8,p0,vl);
+        unsigned pixels=(unsigned)vl*4;a+=pixels;b+=pixels;output+=pixels;count-=pixels;
+    }
+    while(count--)*output++=packed_pair_scalar(*a++,*b++,palette);
+}
