+/* One lane carries four neighboring source pixels. This reduces both input
+ * memory operations and output stores while preserving every palette lookup. */
+/* The low nibble of each byte says whether its palette index is opaque.
+ * Nibble addition cannot carry into the next byte. Expanding bit 4 with
+ * (bit << 4) - (bit >> 4) yields independent 0xff/0x00 byte masks, including
+ * the top byte under unsigned wraparound. Select all four pixels together. */
+static inline __attribute__((always_inline)) vuint32m4_t packed_opaque_mask(
+        vuint32m4_t values,size_t vl) {
+    vuint32m4_t n=__riscv_vand_vx_u32m4(values,0x0f0f0f0f,vl);
+    n=__riscv_vadd_vx_u32m4(n,0x0f0f0f0f,vl);
+    n=__riscv_vand_vx_u32m4(n,0x10101010,vl);
+    return __riscv_vsub_vv_u32m4(__riscv_vsll_vx_u32m4(n,4,vl),
+        __riscv_vsrl_vx_u32m4(n,4,vl),vl);
+}
+static inline __attribute__((always_inline)) vuint32m4_t packed_pair_color(
+        vuint32m4_t selected,unsigned shift,const uint16_t* palette,size_t vl) {
+    if(shift)selected=__riscv_vsrl_vx_u32m4(selected,shift,vl);
+    selected=__riscv_vand_vx_u32m4(selected,255,vl);
+    selected=__riscv_vsll_vx_u32m4(selected,1,vl);
+    vuint16m2_t color=__riscv_vluxei32_v_u16m2(palette,selected,vl);
+    return __riscv_vzext_vf2_u32m4(color,vl);
+}
