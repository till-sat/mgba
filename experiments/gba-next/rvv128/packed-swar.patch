+    unsigned index=(a&15)?a:(b&15)?b:0;
+    return palette[index]&0x7fff;
+}
+void gbn_ppu_packed_pair_vector(const uint8_t* a,const uint8_t* b,
+        const uint8_t* palette_bytes,uint16_t* output,unsigned count) {
+    const uint16_t* palette=(const uint16_t*)palette_bytes;
+    if(count && ((uintptr_t)output&3)) {
+        *output++=packed_pair_scalar(*a++,*b++,palette);--count;
+    }
+    while(count>=4) {
+        size_t vl=__riscv_vsetvl_e32m4(count/4);
+        unsigned sa=((uintptr_t)a&3)*8,sb=((uintptr_t)b&3)*8;
+        const uint32_t* ap=(const uint32_t*)((uintptr_t)a&~(uintptr_t)3);
+        const uint32_t* bp=(const uint32_t*)((uintptr_t)b&~(uintptr_t)3);
+        vuint32m4_t av=__riscv_vle32_v_u32m4(ap,vl);
+        vuint32m4_t bv=__riscv_vle32_v_u32m4(bp,vl);
+        if(sa) {
+            vuint32m4_t next=__riscv_vle32_v_u32m4(ap+1,vl);
+            av=__riscv_vor_vv_u32m4(__riscv_vsrl_vx_u32m4(av,sa,vl),__riscv_vsll_vx_u32m4(next,32-sa,vl),vl);
+        }
+        if(sb) {
+            vuint32m4_t next=__riscv_vle32_v_u32m4(bp+1,vl);
+            bv=__riscv_vor_vv_u32m4(__riscv_vsrl_vx_u32m4(bv,sb,vl),__riscv_vsll_vx_u32m4(next,32-sb,vl),vl);
+        }
+        vuint32m4_t ma=packed_opaque_mask(av,vl);
+        vuint32m4_t selected=__riscv_vxor_vv_u32m4(bv,
+            __riscv_vand_vv_u32m4(__riscv_vxor_vv_u32m4(av,bv,vl),ma,vl),vl);
