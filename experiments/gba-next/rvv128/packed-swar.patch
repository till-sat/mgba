+/* SPDX-License-Identifier: MPL-2.0 */
+#ifdef GBN_PPU_PAIR_TEST
+uint32_t gbn_ppu_pair_pixels,gbn_ppu_pair_aliases;
+#endif
+static bool packed_pair_overlap(const void* av,size_t an,const void* bv,size_t bn){
+    uintptr_t a=(uintptr_t)av,b=(uintptr_t)bv;
+    return a<=b?b-a<an:a-b<bn;
+}
+static __attribute__((noinline)) void indexed_packed_span(const struct GbnDevices* d,
+        const struct IndexedBackground* layers,unsigned count,const struct Pixel* objects,
+        unsigned start,unsigned end,uint16_t backdrop,uint16_t* output) {
+#if defined(AM_RVV) && !(GBN_PPU_RVV & 4)
+    if(count==2 && !objects && d->ppu.cache && end-start>=16 && !((uintptr_t)d->palette&1)) {
+        const uint8_t* a=layers[0].indices;
+        const uint8_t* b=layers[1].indices;
+        /* Cached rows initialize all 248 bytes. Each pointer includes a 0..7
+         * fine-scroll phase: its 240-byte covering words remain in that row.
+         * Reject aliases before reading ahead or grouping output stores. */
+        const void* ap=(const void*)((uintptr_t)a&~(uintptr_t)3);
+        const void* bp=(const void*)((uintptr_t)b&~(uintptr_t)3);
+        if(!packed_pair_overlap(output,480,d->palette,512) &&
+           !packed_pair_overlap(output,480,ap,240+((uintptr_t)a&3?4:0)) &&
+           !packed_pair_overlap(output,480,bp,240+((uintptr_t)b&3?4:0))) {
+            gbn_ppu_packed_pair_vector(a+start,b+start,d->palette,output+start,end-start);
+#ifdef GBN_PPU_PAIR_TEST
+            gbn_ppu_pair_pixels+=end-start;
+#endif
+            return;
+        }
+#ifdef GBN_PPU_PAIR_TEST
+        ++gbn_ppu_pair_aliases;
+#endif
+    }
+#endif
+    indexed_span(layers,count,objects,start,end,d->palette,backdrop,output);
+}
+#ifdef GBN_PPU_PAIR_TEST
+void gbn_test_ppu_pair(struct GbnDevices* d,const struct IndexedBackground* layers,
+        unsigned count,const struct Pixel* objects,unsigned start,unsigned end,uint16_t* output){
+    indexed_packed_span(d,layers,count,objects,start,end,half(d->palette,0)&0x7fff,output);
+}
+#endif
