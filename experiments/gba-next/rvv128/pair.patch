+/* e32,m8 compares 32 aligned words per iteration at VLEN=128. Use returned
+ * VL so every byte is checked, including on a different legal vector length. */
+bool gbn_ppu_palette_equal_vector(const uint8_t* a, const uint8_t* b) {
+    for (unsigned i=0; i<128;) {
+        size_t vl=__riscv_vsetvl_e32m8(128-i);
+        vuint32m8_t av=__riscv_vle32_v_u32m8((const uint32_t*)(a+4*i),vl);
+        vuint32m8_t bv=__riscv_vle32_v_u32m8((const uint32_t*)(b+4*i),vl);
+        vbool4_t different=__riscv_vmsne_vv_u32m8_b4(av,bv,vl);
+        if (__riscv_vfirst_m_b4(different,vl)>=0) return false;
+        i+=(unsigned)vl;
+    }
+    return true;
+}
+
+/* Two byte planes become 32-bit table offsets. The 128 KiB table requires
+ * 17 offset bits; a 16-bit gather would wrap the upper half. */
+void gbn_ppu_pair_vector(const uint8_t* a, const uint8_t* b,
+        const uint16_t* table, uint16_t* output, unsigned count) {
+    for (unsigned i=0; i<count;) {
+        size_t vl=__riscv_vsetvl_e16m4(count-i);
+        vuint8m2_t av=__riscv_vle8_v_u8m2(a+i,vl);
+        vuint8m2_t bv=__riscv_vle8_v_u8m2(b+i,vl);
+        vuint16m4_t high=__riscv_vzext_vf2_u16m4(av,vl);
+        vuint16m4_t low=__riscv_vzext_vf2_u16m4(bv,vl);
+        high=__riscv_vsll_vx_u16m4(high,8,vl);
+        high=__riscv_vor_vv_u16m4(high,low,vl);
+        vuint32m8_t offsets=__riscv_vzext_vf2_u32m8(high,vl);
+        offsets=__riscv_vsll_vx_u32m8(offsets,1,vl);
+        vuint16m4_t colors=__riscv_vluxei32_v_u16m4(table,offsets,vl);
+        __riscv_vse16_v_u16m4(output+i,colors,vl);
+        i+=(unsigned)vl;
+    }
+}
+#endif
