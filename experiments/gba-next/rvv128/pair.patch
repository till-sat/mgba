+/* SPDX-License-Identifier: MPL-2.0 */
+/* Fuse opaque selection and palette conversion. The inputs are the two
+ * already priority-sorted index planes, including their transparent bank
+ * entries. This cache depends only on all 512 live background palette bytes;
+ * no VRAM write tracking or frame reuse is involved. */
+#ifdef GBN_PPU_PAIR_TEST
+uint32_t gbn_ppu_pair_pixels, gbn_ppu_pair_rebuilds, gbn_ppu_pair_aliases;
+#endif
+static __attribute__((noinline)) const uint16_t* ppu_pair_table(struct GbnPpuCache* c,
+        const uint8_t* palette) {
+    bool equal=false;
+    if (c->pair_valid) {
+#if defined(AM_RVV)
+        if (!((uintptr_t)palette&3)) equal=gbn_ppu_palette_equal_vector(c->pair_palette,palette);
+        else
+#endif
+        equal=!memcmp(c->pair_palette,palette,512);
+    }
+    if (!equal) {
+        uint16_t bottom[256];
+        uint16_t backdrop=half(palette,0)&0x7fff;
+        for (unsigned b=0;b<256;++b) bottom[b]=(b&15)?half(palette,b*2)&0x7fff:backdrop;
+        for (unsigned a=0;a<256;++a) {
+            uint16_t* row=c->pair_colors+a*256;
+            if (a&15) {
+                uint16_t color=half(palette,a*2)&0x7fff;
+                for (unsigned b=0;b<256;++b) row[b]=color;
+            } else memcpy(row,bottom,sizeof(bottom));
+        }
+        memcpy(c->pair_palette,palette,512);
+        c->pair_valid=true;
+#ifdef GBN_PPU_PAIR_TEST
+        ++gbn_ppu_pair_rebuilds;
+#endif
+    }
+    return c->pair_colors;
+}
+
+static __attribute__((noinline)) void indexed_pair_span(const struct GbnDevices* d,
+        const struct IndexedBackground* layers,unsigned count,const struct Pixel* objects,
+        unsigned start,unsigned end,uint16_t backdrop,uint16_t* output,const uint16_t** pair) {
+#if !defined(AM_RVV) || !(GBN_PPU_RVV & 4)
+    struct GbnPpuCache* c=d->ppu.cache;
+    if (count==2 && !objects && end-start>=16 && c) {
+        const uint8_t* a=layers[0].indices;
+        const uint8_t* b=layers[1].indices;
+        /* Preserve pixel-by-pixel behavior for all legal source/output aliases.
+         * Check the whole output row, since a preceding span may write palette.
+         * Table construction must not modify any live renderer input either. */
+        if (ppu_pair_overlap(output,480,d->palette,512) ||
+            ppu_pair_overlap(output,480,c,sizeof(*c)) ||
+            ppu_pair_overlap(output,480,a,240) || ppu_pair_overlap(output,480,b,240) ||
+            ppu_pair_overlap(c,sizeof(*c),d->palette,GBN_PALETTE_SIZE) ||
+            ppu_pair_overlap(c,sizeof(*c),d->vram,GBN_VRAM_SIZE) ||
+            ppu_pair_overlap(c,sizeof(*c),d->oam,GBN_OAM_SIZE) ||
+            ppu_pair_overlap(c,sizeof(*c),d,sizeof(*d)) ||
+            ppu_pair_overlap(c->pair_colors,sizeof(c->pair_colors),a,240) ||
+            ppu_pair_overlap(c->pair_colors,sizeof(c->pair_colors),b,240)) {
+#ifdef GBN_PPU_PAIR_TEST
+            ++gbn_ppu_pair_aliases;
+#endif
+        } else {
+            const uint16_t* table=*pair;
+            if (!table) *pair=table=ppu_pair_table(c,d->palette);
+#if defined(AM_RVV)
+            gbn_ppu_pair_vector(a+start,b+start,table,output+start,end-start);
+#else
+            for (unsigned x=start;x<end;++x) output[x]=table[(unsigned)a[x]*256+b[x]];
+#endif
+#ifdef GBN_PPU_PAIR_TEST
+            gbn_ppu_pair_pixels+=end-start;
+#endif
+            return;
+        }
+    }
+#else
+    (void) pair;
+#endif
+    indexed_span(layers,count,objects,start,end,d->palette,backdrop,output);
+}
+#ifdef GBN_PPU_PAIR_TEST
+void gbn_test_ppu_pair(struct GbnDevices* d,const struct IndexedBackground* layers,
+        unsigned count,const struct Pixel* objects,unsigned start,unsigned end,uint16_t* output) {
+    const uint16_t* pair=NULL;
+    indexed_pair_span(d,layers,count,objects,start,end,half(d->palette,0)&0x7fff,output,&pair);
+    if(d->ppu.cache && ppu_pair_overlap(output,480,d->ppu.cache,sizeof(*d->ppu.cache)))
+        d->ppu.cache->pair_valid=false;
+}
+#endif
